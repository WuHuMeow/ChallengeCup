{
  "components": {
    "schemas": {
      "ControlActionModel": {
        "properties": {
          "action_type": {
            "title": "Action Type",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "tls_id": {
            "title": "Tls Id",
            "type": "string"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "tls_id",
          "action_type",
          "value"
        ],
        "title": "ControlActionModel",
        "type": "object"
      },
      "ControlActionsModel": {
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/ControlActionModel"
            },
            "title": "Actions",
            "type": "array"
          }
        },
        "required": [
          "actions"
        ],
        "title": "ControlActionsModel",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JointStateModel": {
        "properties": {
          "arrival_history": {
            "items": {
              "type": "integer"
            },
            "title": "Arrival History",
            "type": "array"
          },
          "current_phase": {
            "minimum": 0.0,
            "title": "Current Phase",
            "type": "integer"
          },
          "current_phase_name": {
            "title": "Current Phase Name",
            "type": "string"
          },
          "detector_values": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Detector Values",
            "type": "object"
          },
          "elapsed_phase_time": {
            "minimum": 0.0,
            "title": "Elapsed Phase Time",
            "type": "number"
          },
          "flows": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Flows",
            "type": "object"
          },
          "phase_states": {
            "items": {
              "$ref": "#/components/schemas/PhaseTrafficStateModel"
            },
            "title": "Phase States",
            "type": "array"
          },
          "queues": {
            "items": {
              "$ref": "#/components/schemas/QueueStateModel"
            },
            "title": "Queues",
            "type": "array"
          },
          "step": {
            "minimum": 0.0,
            "title": "Step",
            "type": "integer"
          },
          "timestamp": {
            "minimum": 0.0,
            "title": "Timestamp",
            "type": "number"
          },
          "tls_id": {
            "title": "Tls Id",
            "type": "string"
          },
          "vehicles": {
            "items": {
              "$ref": "#/components/schemas/VehicleStateModel"
            },
            "title": "Vehicles",
            "type": "array"
          }
        },
        "required": [
          "step",
          "timestamp",
          "tls_id",
          "current_phase",
          "current_phase_name",
          "elapsed_phase_time"
        ],
        "title": "JointStateModel",
        "type": "object"
      },
      "PhaseTrafficStateModel": {
        "properties": {
          "incoming_capacity": {
            "minimum": 0.0,
            "title": "Incoming Capacity",
            "type": "number"
          },
          "incoming_lanes": {
            "items": {
              "type": "string"
            },
            "title": "Incoming Lanes",
            "type": "array"
          },
          "incoming_queue": {
            "minimum": 0.0,
            "title": "Incoming Queue",
            "type": "number"
          },
          "nominal_duration": {
            "exclusiveMinimum": 0.0,
            "title": "Nominal Duration",
            "type": "number"
          },
          "outgoing_capacity": {
            "minimum": 0.0,
            "title": "Outgoing Capacity",
            "type": "number"
          },
          "outgoing_lanes": {
            "items": {
              "type": "string"
            },
            "title": "Outgoing Lanes",
            "type": "array"
          },
          "outgoing_occupancy": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Outgoing Occupancy",
            "type": "number"
          },
          "outgoing_queue": {
            "minimum": 0.0,
            "title": "Outgoing Queue",
            "type": "number"
          },
          "phase_index": {
            "minimum": 0.0,
            "title": "Phase Index",
            "type": "integer"
          },
          "signal_state": {
            "title": "Signal State",
            "type": "string"
          }
        },
        "required": [
          "phase_index",
          "signal_state",
          "nominal_duration",
          "incoming_queue",
          "incoming_capacity",
          "outgoing_queue",
          "outgoing_capacity",
          "outgoing_occupancy"
        ],
        "title": "PhaseTrafficStateModel",
        "type": "object"
      },
      "PredictionResultModel": {
        "properties": {
          "horizon_seconds": {
            "title": "Horizon Seconds",
            "type": "number"
          },
          "horizon_steps": {
            "title": "Horizon Steps",
            "type": "integer"
          },
          "predicted_flows": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Predicted Flows",
            "type": "object"
          }
        },
        "required": [
          "horizon_steps",
          "horizon_seconds",
          "predicted_flows"
        ],
        "title": "PredictionResultModel",
        "type": "object"
      },
      "QueueStateModel": {
        "properties": {
          "capacity": {
            "default": 0.0,
            "minimum": 0.0,
            "title": "Capacity",
            "type": "number"
          },
          "direction": {
            "title": "Direction",
            "type": "string"
          },
          "queue_length": {
            "minimum": 0.0,
            "title": "Queue Length",
            "type": "number"
          },
          "vehicle_count": {
            "minimum": 0.0,
            "title": "Vehicle Count",
            "type": "integer"
          },
          "waiting_time": {
            "minimum": 0.0,
            "title": "Waiting Time",
            "type": "number"
          }
        },
        "required": [
          "direction",
          "queue_length",
          "waiting_time",
          "vehicle_count"
        ],
        "title": "QueueStateModel",
        "type": "object"
      },
      "RunRequestModel": {
        "properties": {
          "algorithm": {
            "enum": [
              "fixed_time",
              "actuated",
              "ca_maxpressure"
            ],
            "title": "Algorithm",
            "type": "string"
          },
          "algorithm_params": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Algorithm Params",
            "type": "object"
          },
          "edge_delay_steps": {
            "default": 0,
            "minimum": 0.0,
            "title": "Edge Delay Steps",
            "type": "integer"
          },
          "edge_directions": {
            "items": {
              "type": "string"
            },
            "title": "Edge Directions",
            "type": "array"
          },
          "flow_multiplier": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Flow Multiplier",
            "type": "number"
          },
          "intersection_id": {
            "pattern": "^(?:[1-9]|1[0-9]|20)$",
            "title": "Intersection Id",
            "type": "string"
          },
          "seed": {
            "default": 42,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "steps": {
            "default": 36000,
            "exclusiveMinimum": 0.0,
            "title": "Steps",
            "type": "integer"
          },
          "variant": {
            "$ref": "#/components/schemas/VariantSpecModel"
          }
        },
        "required": [
          "intersection_id",
          "algorithm"
        ],
        "title": "RunRequestModel",
        "type": "object"
      },
      "RunResultModel": {
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "run_dir": {
            "title": "Run Dir",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "summary": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "required": [
          "run_id",
          "status",
          "reason",
          "run_dir"
        ],
        "title": "RunResultModel",
        "type": "object"
      },
      "RunStatus": {
        "description": "Stable lifecycle states used by runners, services, APIs, and reports.",
        "enum": [
          "queued",
          "running",
          "completed",
          "stopped",
          "ended_early",
          "disconnected",
          "interrupted",
          "failed"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "StateRequestModel": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/JointStateModel"
          }
        },
        "required": [
          "state"
        ],
        "title": "StateRequestModel",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VariantSpecModel": {
        "properties": {
          "closed_lanes": {
            "items": {
              "type": "string"
            },
            "title": "Closed Lanes",
            "type": "array"
          },
          "closure_begin": {
            "default": 0.0,
            "minimum": 0.0,
            "title": "Closure Begin",
            "type": "number"
          },
          "closure_end": {
            "default": 3600.0,
            "minimum": 0.0,
            "title": "Closure End",
            "type": "number"
          },
          "signal_duration_scale": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Signal Duration Scale",
            "type": "number"
          },
          "vehicle_type_overrides": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Vehicle Type Overrides",
            "type": "object"
          }
        },
        "title": "VariantSpecModel",
        "type": "object"
      },
      "VehicleStateModel": {
        "properties": {
          "lane_id": {
            "title": "Lane Id",
            "type": "string"
          },
          "speed": {
            "title": "Speed",
            "type": "number"
          },
          "vehicle_id": {
            "title": "Vehicle Id",
            "type": "string"
          }
        },
        "required": [
          "vehicle_id",
          "lane_id",
          "speed"
        ],
        "title": "VehicleStateModel",
        "type": "object"
      }
    }
  },
